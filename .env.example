# Mini India Ireland — environment template
# Copy to .env.local for local development. Never commit real secrets.

# Demo data store. PostgreSQL is not required to run the MVP.
# When you connect Postgres later, point this at your database.
DATABASE_URL=postgresql://miniindia:miniindia@localhost:5432/miniindia

# Reserved for a future cache layer. The MVP does not require Redis.
REDIS_URL=redis://localhost:6379

# Optional. Leave blank to use the built-in delivery map.
GOOGLE_MAPS_API_KEY=

# Optional. Checkout uses demo payment when these are empty.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Used to sign demo session cookies. Replace before any public deployment.
JWT_SECRET=replace-with-a-long-random-string

# Browser-facing API origin. Same-origin by default.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Set to "false" to hide demo address shortcuts.
NEXT_PUBLIC_DEMO_MODE=true
